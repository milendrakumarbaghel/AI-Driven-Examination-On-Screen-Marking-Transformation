target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
*.iml
.mvn/
!.mvn/wrapper/
.settings/
.project
.classpath
.factorypath

# Python / AI Service
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
venv/
env/
ENV/
.venv/
pip-log.txt
pip-delete-this-directory.txt
